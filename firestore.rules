rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Configuration pour la collection des utilisateurs
    match /users/{userId} {
      // Un utilisateur peut lire son propre profil
      // Les admins peuvent lire tous les profils
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superAdmin']
      );
      
      // Seul l'utilisateur peut créer son propre profil à l'inscription
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Mise à jour des données :
      // 1. L'utilisateur peut mettre à jour ses données de base (nom, avatar)
      // 2. Un Admin/SuperAdmin peut tout mettre à jour (y compris l'or et les rôles)
      allow update: if request.auth != null && (
        request.auth.uid == userId || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superAdmin']
      );
    }
    
    // Autres collections (si existantes) - tout bloqué par défaut
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
